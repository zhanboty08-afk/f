<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="data\*.csv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="runtimes\win-x64\native\budget_native.dll"
             CopyToOutputDirectory="PreserveNewest"
             Link="runtimes\win-x64\native\budget_native.dll"
             Condition="Exists('runtimes\win-x64\native\budget_native.dll')" />
  </ItemGroup>
</Project>
